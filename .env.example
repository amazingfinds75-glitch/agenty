# AI Viral Studio — local backend configuration.
# Copy to .env (never commit real keys) and restart `npm run server`.

PORT=8787
# 127.0.0.1 = this computer only. 0.0.0.0 = reachable from phones/tablets on your Wi-Fi.
# When exposed on a network the API has no login, so only use a trusted network.
HOST=127.0.0.1

# Live trend feeds
TRENDS_GEO=US
REFRESH_MINUTES=5
# Optional: include the YouTube most-popular chart. No key means that source stays "not configured".
YOUTUBE_API_KEY=

# Optional AI text provider for signal analysis.
# AI_PROVIDER: openai | anthropic | gemini. Leave empty to auto-detect from the keys below.
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional external AI video provider (scaffolding; unverified until a real job completes).
# VIDEO_PROVIDER: luma | replicate
VIDEO_PROVIDER=
LUMA_API_KEY=
LUMA_MODEL=ray-2
REPLICATE_API_TOKEN=
REPLICATE_VIDEO_VERSION=

# Optional: allow a specific browser origin to call the API when not using the Vite proxy.
CORS_ORIGIN=
